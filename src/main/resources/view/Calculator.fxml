<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CalculatorController">
   <children>
      <!-- Menghubungkan tampilan layar dengan id 'display' di controller -->
      <TextField fx:id="display" alignment="CENTER_RIGHT" editable="false" prefHeight="60.0" prefWidth="240.0" style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50;">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </TextField>

      <!-- Mengatur susunan tombol menggunakan GridPane -->
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <!-- Baris 1 -->
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="7" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="8" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="9" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <Button onAction="#processOperator" prefHeight="50.0" prefWidth="50.0" text="/" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <!-- Baris 2 -->
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Button onAction="#processOperator" prefHeight="50.0" prefWidth="50.0" text="*" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <!-- Baris 3 -->
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="1" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="2" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="3" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Button onAction="#processOperator" prefHeight="50.0" prefWidth="50.0" text="-" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <!-- Baris 4 -->
            <Button onAction="#clearDisplay" prefHeight="50.0" prefWidth="50.0" text="C" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button onAction="#processNumber" prefHeight="50.0" prefWidth="50.0" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button onAction="#processOperator" prefHeight="50.0" prefWidth="50.0" text="=" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Button onAction="#processOperator" prefHeight="50.0" prefWidth="50.0" text="+" GridPane.columnIndex="3" GridPane.rowIndex="3" />
         </children>
      </GridPane>
   </children>
</VBox>
